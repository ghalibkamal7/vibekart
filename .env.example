# Copy this file to .env and fill in your own Firebase project's values.
# Get these from: Firebase Console -> Project settings -> General -> Your apps -> Web app config
#
# These EXPO_PUBLIC_* values are bundled into the client and are NOT secret —
# Firebase's web/client config is meant to be public. Real access control
# happens in firestore.rules, not by hiding these values. Never put a
# service-account key, admin SDK credential, or any other server-only secret
# in a variable prefixed with EXPO_PUBLIC_.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary holds product images (Firebase Storage isn't used at all — see
# README). Uploads go straight from this app to Cloudinary using an
# UNSIGNED upload preset — no API key or secret is ever needed on the
# client, and no Cloud Function is involved. Both values below are meant to
# be public — same trust model as the Firebase config above — but see
# README.md for exactly how to lock the preset down on Cloudinary's side.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Mobile OTP login goes through a Cloudflare Worker (not a Firebase Cloud
# Function — this project stays on Firebase's free Spark plan, and Cloud
# Functions require Blaze to deploy at all, secrets or not). The Worker URL
# itself isn't sensitive (it's just an endpoint, same trust model as any
# other API base URL) — the MSG91 key and Firebase service-account
# credentials it uses are Cloudflare Worker secrets, set separately, and
# never appear in this app. See workers/otp/README.md to deploy the Worker
# and get this URL.
EXPO_PUBLIC_OTP_WORKER_URL=

# Google Sign-In on iOS/Android (native). The *Web* OAuth client ID of this
# Firebase project — Firebase Console -> Authentication -> Sign-in method ->
# Google -> "Web SDK configuration" -> Web client ID (ends in
# .apps.googleusercontent.com). OAuth client IDs are public identifiers, not
# secrets (never paste the client *secret* here). Web sign-in doesn't need
# this variable at all; it's only read by the native implementation.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# MANUAL UPI PAYMENT CONFIGURATION
#
# Cash on Delivery (COD) is removed. All orders require online payment.
# Configure the merchant VPA and QR/instructions in Admin -> Payment Settings.
# A customer UTR is only a submitted reference; an authorized admin must verify
# the actual merchant-account credit before an order is created.
#
# These optional public values are legacy payment-config display fallbacks.
# They do not verify or mark a payment as paid:
#   EXPO_PUBLIC_MERCHANT_NAME=VibeKart
#
# Checkout and admin review also require EXPO_PUBLIC_OTP_WORKER_URL to point to
# the configured Cloudflare Worker. No PSP gateway or paid Firebase service is
# required for manual verification.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_PAYMENT_GATEWAY_CONFIGURED=false
EXPO_PUBLIC_MERCHANT_NAME=VibeKart
EXPO_PUBLIC_MERCHANT_VPA=
EXPO_PUBLIC_MERCHANT_MCC=5399
EXPO_PUBLIC_GPAY_ENV=TEST

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (do not prefix with EXPO_PUBLIC_, do not put in this
# mobile app at all, never commit to Git).
#
# IMPORTANT: this project is intentionally on Firebase's Spark (free) plan.
# Cloud Functions require the Blaze (pay-as-you-go) plan to deploy. The optional
# reconcileOrderCost function remains in functions/index.js, but current UPI
# orders receive trusted cost/profit snapshots from the Cloudflare Worker and
# do not depend on that function. See README.md's "Known limitations".
#
# MSG91_AUTH_KEY and FIREBASE_SERVICE_ACCOUNT_JSON are NOT Firebase secrets
# anymore — they're Cloudflare Worker secrets, set from workers/otp/:
#   cd workers/otp
#   npx wrangler secret put MSG91_AUTH_KEY
#   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT_JSON
# One more piece of OTP config — MSG91_TEMPLATE_ID (a DLT-approved SMS
# template id, not a secret) — lives in workers/otp/wrangler.toml, not here
# or in any .env. See workers/otp/README.md for the full setup.
# ---------------------------------------------------------------------------