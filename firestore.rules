rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended');
    }

    function isActiveAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended');
    }

    function isSeller() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
        (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended');
    }

    function isSellerStatusTransition() {
      return (resource.data.status == 'Placed' &&
          request.resource.data.status in ['Confirmed', 'Processing']) ||
        (resource.data.status == 'Confirmed' &&
          request.resource.data.status == 'Processing') ||
        (resource.data.status == 'Processing' &&
          request.resource.data.status == 'Shipped') ||
        (resource.data.status == 'Shipped' &&
          request.resource.data.status == 'Delivered');
    }

    function hasValidCancellationMetadata() {
      return request.resource.data.cancelledAt == request.time &&
        request.resource.data.cancellationReason is string &&
        request.resource.data.cancellationReason.size() > 0 &&
        request.resource.data.cancellationReason.size() <= 120;
    }

    // ---------------- otp_requests ----------------
    // Written only by the Cloudflare Worker / Admin SDK, which bypasses
    // these rules entirely. Direct client read/write is completely blocked.
    match /otp_requests/{phone} {
      allow read, write: if false;
    }

    // ---------------- users ----------------
    // Every signed-in user can read their own profile; admins can read all profiles.
    // Self-profile updates are strictly restricted to safe fields (name, phone, updatedAt).
    // Privileged fields (role, status, email, uid) can NEVER be self-assigned or escalated.
    // Admins can update roles/status, but cannot demote or suspend themselves (preventing lockout).
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();

      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'customer' &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active');

      allow update: if (
        // Case A: User self-profile update (restricted strictly to name, phone, updatedAt)
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        (!('status' in resource.data) || request.resource.data.status == resource.data.status)
      ) || (
        // Case B: Admin managing other users or safe fields on own profile
        isAdmin() && (
          // Admin updating another user: role must be valid, status must be valid
          (request.auth.uid != uid &&
           request.resource.data.role in ['customer', 'seller', 'admin'] &&
           (!('status' in request.resource.data) || request.resource.data.status in ['active', 'suspended'])) ||
          // Admin updating own profile: cannot self-demote away from admin or suspend themselves
          (request.auth.uid == uid &&
           request.resource.data.role == 'admin' &&
           (!('status' in request.resource.data) || request.resource.data.status == 'active'))
        )
      );

      allow delete: if false;
    }

    // ---------------- categories ----------------
    // Read: signed-in users.
    // Write: only active sellers or admins.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSeller();
    }

    // ---------------- products (public fields) ----------------
    // Read: signed-in users.
    // Write: only active sellers or admins.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSeller() &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if isSeller() &&
        request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null) &&
        (isAdmin() || resource.data.get('createdByUid', null) == request.auth.uid);
      // Deletion is routed through the Worker so Cloudinary cleanup and both
      // Firestore product documents are handled together.
      allow delete: if false;

      // ---------------- products/{id}/private/data (cost & source fields) ----------------
      // Customer read denied completely; only active sellers/admins can read or write.
      match /private/{docId} {
        allow read, write: if isSeller();
      }
    }

    // ---------------- orders ----------------
    match /orders/{orderId} {
      // The trusted Worker prices and creates manual UPI orders; client writes
      // cannot establish or alter the authoritative order price.
      allow create: if false;

      allow read: if isSignedIn() && (
        !exists(/databases/$(database)/documents/orders/$(orderId)) ||
        resource.data.customerUid == request.auth.uid ||
        isSeller()
      );

      // Customers may submit an unverified UTR on their own pending order;
      // only active admins can change payment status or reserve a reference.
      allow update: if (
        isAdmin() &&
        resource.data.paymentMethod == 'UPI' &&
        resource.data.get('paymentStatus', 'Selected') in ['Pending', 'Selected'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'customerUtr', 'paymentReference', 'paymentVerifiedAt', 'paymentReviewReason', 'status']) &&
        (
          (
            request.resource.data.paymentStatus == 'Paid' &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.paymentReference is string &&
            request.resource.data.paymentReference.size() > 0 &&
            request.resource.data.paymentReference.size() <= 100 &&
            request.resource.data.paymentVerifiedAt == request.time
          ) ||
          (
            request.resource.data.paymentStatus == 'Failed' &&
            request.resource.data.status == 'Cancelled' &&
            request.resource.data.paymentReviewReason is string &&
            request.resource.data.paymentReviewReason.size() > 0 &&
            request.resource.data.paymentReviewReason.size() <= 300
          )
        )
      ) || (
        isActiveAccount() &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.paymentMethod == 'UPI' &&
        resource.data.get('paymentStatus', 'Selected') in ['Pending', 'Selected'] &&
        request.resource.data.get('paymentStatus', 'Selected') ==
          resource.data.get('paymentStatus', 'Selected') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerUtr']) &&
        request.resource.data.customerUtr is string &&
        request.resource.data.customerUtr.size() > 0 &&
        request.resource.data.customerUtr.size() <= 100
      ) || (
        isSeller() &&
        resource.data.paymentStatus == 'Paid' &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trackingId']) &&
            request.resource.data.status == resource.data.status
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            isSellerStatusTransition()
          ) ||
          (
            request.resource.data.status == 'Cancelled' &&
            resource.data.status in ['Placed', 'Confirmed', 'Processing'] &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt', 'cancellationReason']) &&
            hasValidCancellationMetadata()
          )
        )
      ) || (
        isSignedIn() &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.paymentStatus == 'Paid' &&
        (resource.data.status == 'Placed' || resource.data.status == 'Confirmed') &&
        request.resource.data.status == 'Cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'cancellationReason']) &&
        request.resource.data.cancellationReason == 'Customer requested cancellation' &&
        hasValidCancellationMetadata()
      );

      allow delete: if false;

      // ---------------- orders/{orderId}/private/data (cost & profit fields) ----------------
      // Strictly inaccessible to customers; only active sellers/admins.
      match /private/{docId} {
        allow read, write: if isSeller();
      }
    }

    // ---------------- payment_attempts ----------------
    // Clients may inspect their own attempts; only the trusted Worker creates
    // or changes attempts and can authorize verification/finalization.
    match /payment_attempts/{attemptId} {
      allow read: if isSignedIn() &&
        (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // A unique claim document prevents a submitted transaction reference from
    // being used to confirm more than one payment/order.
    match /payment_reference_claims/{referenceHash} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['orderId', 'reference', 'createdAt']) &&
        request.resource.data.orderId is string &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() > 0 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------- settings ----------------
    // Read: all signed-in users (to load banner, store name).
    // Write: only admins.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- audit_logs ----------------
    // Administrative activity logging.
    // Read/Create: only authenticated admins for their own UID.
    // Updates and deletes are disallowed.
    // NOTE: Client-written logs provide administrative history and cannot be updated
    // or deleted by clients, but should not be characterized as cryptographic hardware-proof audit trails.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
